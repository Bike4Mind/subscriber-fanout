{
  "name": "subscriber-fanout",
  "version": "1.2.0",
  "description": "Long-running MongoDB change-stream to WebSocket fan-out service. Image consumed by downstream consumer apps via SST.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bike4Mind/subscriber-fanout.git"
  },
  "scripts": {
    "build": "tsc",
    "build:docker": "tsc --noCheck",
    "start": "node ./dist/index.js",
    "dev": "tsx watch ./src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.34.0"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "3.654.0",
    "@aws-sdk/credential-providers": "^3.665.0",
    "async-mutex": "^0.5.0",
    "dotenv": "^16.3.1",
    "flat": "^6.0.1",
    "lodash-es": "^4.18.1",
    "mongoose": "^7.8.4",
    "p-limit": "^5.0.0",
    "sst": "4.1.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3"
  }
}
